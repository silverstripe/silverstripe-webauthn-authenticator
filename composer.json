{
    "name": "silverstripe/webauthn-authenticator",
    "description": "A WebAuthn authenticator that plugs into the silverstripe/mfa module",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "silverstripe/framework": "^6",
        "silverstripe/mfa": "^6",
        "web-auth/webauthn-lib": "^4.4",
        "guzzlehttp/psr7": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3",
        "silverstripe/documentation-lint": "^1",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\WebAuthn\\": "src/",
            "SilverStripe\\WebAuthn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist",
            "client/lang"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
